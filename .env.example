# No hacen falta keys para Yahoo Finance público, SEC EDGAR, Nasdaq,
# TradingView Scanner, FRED ni Treasury. Estas variables son solo fallback opcional.
#
# Todas se usan SOLO en el servidor: el navegador nunca las recibe (el WebSocket
# de Finnhub que entregaba la llave al cliente se retiró; ver docs/SEGURIDAD.md).
FINNHUB_API_KEY=
DATABURSATIL_TOKEN=
FMP_API_KEY=
POLYGON_API_KEY=
MASSIVE_API_KEY=
FINAGE_API_KEY=
ALPHA_VANTAGE_API_KEY=
TWELVEDATA_API_KEY=

# Opcional para que SEC EDGAR identifique mejor las peticiones.
# Incluye un email de contacto real de tu organización/dominio si lo configuras.
SEC_USER_AGENT=

# Límite de peticiones: pon TRUST_PROXY=1 SOLO si hay un proxy propio delante
# (nginx, Caddy, Cloudflare) que reescriba x-forwarded-for añadiendo la IP real
# al final. En Vercel se detecta solo. Si no se declara, todos los clientes
# comparten un mismo cupo por minuto (ver docs/SEGURIDAD.md, sección 2).
TRUST_PROXY=
